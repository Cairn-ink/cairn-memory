{
  "name": "@cairn-ink/core",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn memory core: storage-independent algorithms and port interfaces.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./routing": {
      "types": "./src/routing/index.d.mts",
      "default": "./src/routing/index.mjs"
    },
    "./ports": {
      "types": "./src/ports/index.d.ts"
    },
    "./service": {
      "types": "./src/service/index.d.mts",
      "default": "./src/service/index.mjs"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:prompt": "node scripts/generate-prompt.mjs --check && node scripts/generate-topics-prompt.mjs --check"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
