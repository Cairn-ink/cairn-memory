{
  "name": "cairn-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight cross-session memory for AI agents, with receipts.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test plugins/cairn-memory/test/*.test.mjs",
    "test:longmemeval": "node --test evaluation/longmemeval/test/*.test.mjs",
    "prepare:longmemeval": "node evaluation/longmemeval/cli.mjs",
    "demo:longmemeval-ingestion": "node evaluation/longmemeval/demo.mjs",
    "test:core": "node --test core/test/*.test.mjs",
    "demo:store": "node examples/local-store.mjs",
    "demo:moc": "node examples/moc-placement.mjs",
    "demo:recall": "node examples/recall.mjs",
    "demo:admission": "node examples/admission.mjs",
    "demo:capture": "node examples/capture.mjs",
    "demo:conflicts": "node examples/conflicts.mjs",
    "demo:rebuild": "node examples/index-rebuild.mjs",
    "demo:continuation": "node examples/recall-continuation.mjs",
    "demo:openai-offline": "node examples/openai-offline.mjs",
    "test:openai-live": "node examples/openai-live.mjs",
    "start:mcp": "node adapters/mcp/cli.mjs",
    "test:mcp": "npm test --prefix adapters/mcp",
    "build:artifact": "node packaging/build.mjs",
    "install:preview": "node packaging/install-preview.mjs",
    "test:artifact": "node --test packaging/test/*.test.mjs",
    "eval:semantic": "node examples/semantic-evaluation.mjs",
    "test:openai": "npm test --prefix adapters/openai",
    "validate": "node scripts/validate-json.mjs",
    "test:experiment-budget": "node --test evaluation/experiment-budget/test/*.test.mjs",
    "demo:experiment-budget": "node evaluation/experiment-budget/example.mjs"
  }
}
