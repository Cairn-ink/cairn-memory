      "query": {
        "text": "What collection procedure and safeguards were recorded for the borrowed acoustic recorder?",
        "date": "2026/10/13 (Tue) 19:40"
      },
      "history": {
        "sessions": [
          {
            "sourceSessionLabel": "cf05.session01",
            "date": "2026/10/08 (Thu) 09:15",
            "turns": [
              {
                "sourceLabel": "cf05.literal01",
                "role": "user",
                "content": "Borrowed acoustic recorder: collect its padded case at the tool-library side hatch after showing the loan slip."
              },
              {
                "sourceLabel": "cf05.literal02",
                "role": "assistant",
                "content": "Before collection, check that the acoustic recorder case contains the short tripod and the foam windscreen."
              },
              {
                "sourceLabel": "cf05.literal03",
                "role": "user",
                "content": "During use, keep the recorder gain knob at the pencil mark made by the technician; do not use the taped red mark."
              },
              {
                "sourceLabel": "cf05.literal04",
                "role": "assistant",
                "content": "If rain starts, stop recording and close the padded case before walking back to the side hatch."
              },
              {
                "sourceLabel": "cf05.literal05",
                "role": "user",
                "content": "After use, return the recorder with the battery drawer open and the memory card left inside its labelled sleeve."
              },
              {
                "sourceLabel": "cf05.literal06",
                "role": "user",
                "content": "At return, ask the volunteer to initial the loan slip so the acoustic recorder checkout can be closed."
              }
            ]
          }
        ]
      },
      "scriptedExtraction": {
        "cards": [
          {
            "cardLabel": "cf05.card01",
            "content": "Borrowed acoustic recorder procedure covers side-hatch collection, tripod and windscreen check, pencil-mark gain, rain protection, battery/card return and signed loan closure.",
            "kind": "fact",
