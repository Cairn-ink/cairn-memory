{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hr3:answer:v1",
  "$comment": "Executable cross-field invariants, finite-domain nonempty scopes and interval/range ordering are additionally checked by validate.mjs. No network resolution.",
  "title": "HR-3 protocol v0.3.4 closed answer schema",
  "$ref": "#/$defs/Answer",
  "$defs": {
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "Text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "Boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "decimal",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "Quantity"
            },
            "decimal": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "iso"
          ],
          "properties": {
            "type": {
              "const": "Instant"
            },
            "iso": {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "lower",
            "upper",
            "lowerClosed",
            "upperClosed",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "Range"
            },
            "lower": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "upper": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lowerClosed": {
              "type": "boolean"
            },
            "upperClosed": {
              "type": "boolean"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "all"
            ],
            "properties": {
              "all": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "country"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "TW",
                              "JP",
                              "US"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "plan"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "free",
                              "pro"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "channel"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "web",
                              "app"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "item",
        "unit",
        "source",
        "quote",
        "occurrence"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "current",
            "history"
          ]
        },
        "item": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "body",
            "receipt"
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "value",
        "scope",
        "valid",
        "qualifiers",
        "citations"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/Value"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "valid": {
          "$ref": "#/$defs/Interval"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/Value"
              }
            }
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
      }
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "old",
        "reason"
      ],
      "properties": {
        "current": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "claims"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "no_active_decision",
                "unresolved"
              ]
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Claim"
              }
            }
          }
        },
        "old": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "records"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "none"
              ]
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "claims"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "previously_adopted",
                      "erroneous",
                      "expired"
                    ]
                  },
                  "claims": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Claim"
                    }
                  }
                }
              }
            }
          }
        },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "nodes",
            "edges"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "stated",
                "not_stated",
                "unavailable"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "claim"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claim": {
                    "$ref": "#/$defs/Claim"
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "citations"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "citations": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Citation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
