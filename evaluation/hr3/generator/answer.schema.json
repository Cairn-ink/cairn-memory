{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current",
    "old",
    "reason"
  ],
  "properties": {
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rows"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "no_active_decision",
            "unresolved"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        }
      }
    },
    "old": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "records"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "none"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predecessor_turn",
              "status",
              "rows"
            ],
            "properties": {
              "predecessor_turn": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "previously_adopted",
                  "erroneous",
                  "expired",
                  "unavailable",
                  "unresolved"
                ]
              },
              "rows": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Row"
                }
              }
            }
          }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "support"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "stated",
            "not_stated",
            "unavailable"
          ]
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hr3:slot-answer:a4:v1",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "all"
            ],
            "properties": {
              "all": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "country"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "TW",
                              "JP",
                              "US"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "plan"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "free",
                              "pro"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field",
                        "values"
                      ],
                      "properties": {
                        "field": {
                          "const": "channel"
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "web",
                              "app"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "Interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "item",
        "unit",
        "source",
        "quote",
        "occurrence"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "current",
            "history"
          ]
        },
        "item": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "body",
            "receipt"
          ]
        },
        "source": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RouteSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "value",
            "not_specified",
            "unavailable",
            "unresolved"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ApprovalSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "value",
            "not_specified",
            "unavailable",
            "unresolved"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "CapSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "value",
            "not_specified",
            "unavailable",
            "unresolved"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decimal",
                "unit"
              ],
              "properties": {
                "decimal": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "valid",
        "route",
        "approval",
        "cap",
        "citations"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "valid": {
          "$ref": "#/$defs/Interval"
        },
        "route": {
          "$ref": "#/$defs/RouteSlot"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalSlot"
        },
        "cap": {
          "$ref": "#/$defs/CapSlot"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        }
      }
    }
  },
  "$comment": "Provider closed structural schema. validateAnswer additionally enforces state/value coupling, address source coupling, valid enums/scopes/times and status/row semantics."
}
