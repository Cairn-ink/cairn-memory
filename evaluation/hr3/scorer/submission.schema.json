{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HR-3 A-4 scorer submission v2",
  "type": "object",
  "properties": {
    "answer": {
      "type": "object",
      "properties": {
        "current": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "active",
                "no_active_decision",
                "unresolved"
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Row"
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "rows"
          ],
          "additionalProperties": false
        },
        "old": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "available",
                "unavailable",
                "none"
              ]
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "predecessor_turn": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "previously_adopted",
                      "erroneous",
                      "expired",
                      "unavailable",
                      "unresolved"
                    ]
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Row"
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "predecessor_turn",
                  "status",
                  "rows"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "records"
          ],
          "additionalProperties": false
        },
        "reason": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "stated",
                "not_stated",
                "unavailable"
              ]
            },
            "support": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Citation"
              },
              "minItems": 0
            }
          },
          "required": [
            "status",
            "support"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "current",
        "old",
        "reason"
      ],
      "additionalProperties": false
    },
    "delivered": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeliveredUnit"
      },
      "minItems": 0
    }
  },
  "required": [
    "answer",
    "delivered"
  ],
  "additionalProperties": false,
  "$defs": {
    "Row": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "valid": {
          "$ref": "#/$defs/Interval"
        },
        "route": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "value"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "not_specified",
                    "unavailable",
                    "unresolved"
                  ]
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "approval": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "value"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "not_specified",
                    "unavailable",
                    "unresolved"
                  ]
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "cap": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "const": "value"
                },
                "value": {
                  "type": "object",
                  "properties": {
                    "decimal": {
                      "type": "string",
                      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$"
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "decimal",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "not_specified",
                    "unavailable",
                    "unresolved"
                  ]
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "state",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 0
        }
      },
      "required": [
        "scope",
        "valid",
        "route",
        "approval",
        "cap",
        "citations"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "all": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "country",
                        "plan",
                        "channel"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "field",
                    "values"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "all"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "any"
      ],
      "additionalProperties": false
    },
    "Interval": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "intent": {
          "enum": [
            "current",
            "history"
          ]
        },
        "item": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "body",
            "receipt"
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "type": "string"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "intent",
        "item",
        "unit",
        "source",
        "quote",
        "occurrence"
      ],
      "additionalProperties": false
    },
    "DeliveredUnit": {
      "type": "object",
      "properties": {
        "intent": {
          "enum": [
            "current",
            "history"
          ]
        },
        "item": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "body",
            "receipt"
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intent": {
                "enum": [
                  "current",
                  "history"
                ]
              },
              "item": {
                "type": "integer",
                "minimum": 0
              },
              "unit": {
                "enum": [
                  "body",
                  "receipt"
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "intent",
              "item",
              "unit",
              "source"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "origin",
              "start",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "normalize": {
          "type": "boolean"
        },
        "truncate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intent",
        "item",
        "unit",
        "source",
        "aliases",
        "segments",
        "normalize",
        "truncate"
      ],
      "additionalProperties": false
    }
  }
}
