{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cairn-ink/cairn-memory/schemas/pause-state.schema.json",
  "title": "Cairn Memory pause-state (protocol 0.2.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paused",
    "generation",
    "enforced"
  ],
  "properties": {
    "paused": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enforced": {
      "type": "boolean"
    }
  }
}
