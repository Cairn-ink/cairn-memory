{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cairn-ink/cairn-memory/schemas/context-read-request.schema.json",
  "title": "Cairn Memory context-read request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "query"],
  "properties": {
    "version": { "const": 1 },
    "query": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]{1,200}$",
      "description": "Optional host conversation/session id from a trusted client, never invented by a model. Use the same wire representation as capture. The server stores only an owner-scoped SHA-256 hash. Invalid or unavailable host ids are omitted by clients."
    },
    "project_id": { "type": "string", "minLength": 16, "maxLength": 128 },
    "max_items": { "type": "integer", "minimum": 1, "maximum": 24 },
    "max_tokens": { "type": "integer", "minimum": 500, "maximum": 6000 }
  }
}
