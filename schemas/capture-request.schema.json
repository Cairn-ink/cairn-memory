{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cairn-ink/cairn-memory/schemas/capture-request.schema.json",
  "title": "Cairn Memory capture request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client",
    "event_id",
    "session_id",
    "messages"
  ],
  "properties": {
    "client": {
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "project_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40,
            "description": "Optional record timestamp, preserved exactly by the client."
          }
        }
      }
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client clock at this send attempt; not part of event identity."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slice",
        "slices",
        "initial"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "slice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "slices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "initial": {
          "type": "boolean"
        }
      }
    }
  }
}
